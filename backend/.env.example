MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=deepverify
REDIS_URL=redis://localhost:6379
JWT_SECRET=deepverify-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:5173
SARVAM_API_KEY=

# AWS Rekognition Settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REKOGNITION_SIMILARITY_THRESHOLD=80.0

# Cloudinary Settings (Optional - falls back to secure local storage if blank)
CLOUDINARY_CLOUD_NAME=Root
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# WebRTC TURN relay (REQUIRED for video between two different networks/laptops)
# Option A: Metered — https://dashboard.metered.ca (free tier)
METERED_DOMAIN=
METERED_API_KEY=
# Option B: static TURN credentials
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
