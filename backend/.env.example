MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=deepverify
REDIS_URL=redis://localhost:6379
JWT_SECRET=deepverify-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:5173
SARVAM_API_KEY=

# AWS Rekognition Settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REKOGNITION_SIMILARITY_THRESHOLD=80.0

# Cloudinary image storage - REQUIRED when MONGODB_URL is a shared/cloud database (Atlas).
# Profile & reference photos are uploaded here so every machine can load them. If these are
# blank, photos are saved to this machine's disk only and will appear broken everywhere else
# (and interview face verification will fail for those accounts). Get the values from the team.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ── WebRTC TURN relays (REQUIRED for video between two different networks) ──
# All configured providers are combined; see backend/api/routes/webrtc.py.

# ExpressTURN — primary relay (free: 1000 GB/month, UDP+TCP port 3478)
EXPRESSTURN_URLS=turn:free.expressturn.com:3478,turn:free.expressturn.com:3478?transport=tcp
EXPRESSTURN_USERNAME=
EXPRESSTURN_CREDENTIAL=

# Metered — backup relay with TLS on 443 for strict firewalls (free: 500 MB/month)
METERED_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=

# Optional alternatives (leave blank if unused)
# Metered via REST API instead of a static credential
METERED_DOMAIN=
METERED_API_KEY=
# Cloudflare Realtime TURN (1000 GB/month free, card required)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Any other TURN server
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
